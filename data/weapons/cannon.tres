[resource]
script = ExtResource("1")
id = &"cannon"
display_name = "炮弹"
description = "射速 70%；无穿透，命中或减速停下时造成 100% 范围爆炸。溅射增加爆炸伤害与范围。"
brief = "减速弹 · 范围爆炸"
fire_rate_scale = 0.7
tags = Array[StringName]([&"projectile", &"explosion"])
