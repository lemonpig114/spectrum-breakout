; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="光谱突围"
config/quit_on_go_back=false
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
run/max_fps=60
config/icon="res://icon.svg"

[autoload]

GameInput="*res://scripts/autoload/GameInput.gd"
EventBus="*res://scripts/autoload/EventBus.gd"
ContentDB="*res://scripts/autoload/ContentDB.gd"
RunState="*res://scripts/autoload/RunState.gd"
Skills="*res://scripts/autoload/SkillSystem.gd"
Pickups="*res://scripts/autoload/PickupSystem.gd"
FX="*res://scripts/autoload/FX.gd"
Audio="*res://scripts/autoload/Audio.gd"
Director="*res://scripts/autoload/Director.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

viewport/hdr_2d=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
